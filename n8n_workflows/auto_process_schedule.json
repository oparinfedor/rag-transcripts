{
  "name": "Автообработка по расписанию",
  "nodes": [
    {
      "parameters": {
        "content": "## Автообработка по расписанию (Workflow 2)\nКаждые 15 минут вызывает \"Process Transcripts\" и, если появились\nновые файлы, шлёт уведомление в Telegram.\n\n**После импорта:**\n1. В узле \"Execute Workflow\" выбери из списка воркфлоу\n   \"Process Transcripts\" (после его импорта) — привязка по ID\n   не переносится между инстансами n8n.\n2. В узле \"Config\" впиши свой telegram_token и allowed_chat_id\n   (тот же бот и чат, что и в TG Bot).\n3. При желании поменяй интервал расписания (по умолчанию 15 мин).",
        "height": 300,
        "width": 400
      },
      "id": "c0-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, -220]
    },
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "c1-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "",
          "mode": "list",
          "cachedResultName": "Process Transcripts"
        },
        "options": {}
      },
      "id": "c2-execute",
      "name": "Execute Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [260, 0],
      "notesInFlow": true,
      "notes": "Выбери воркфлоу 'Process Transcripts' из списка после его импорта."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c3-cond",
              "leftValue": "={{ $json.new_files }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c3-if",
      "name": "New Files > 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c4a",
              "name": "telegram_token",
              "value": "PASTE_YOUR_BOT_TOKEN_HERE",
              "type": "string"
            },
            {
              "id": "c4b",
              "name": "allowed_chat_id",
              "value": "PASTE_YOUR_CHAT_ID_HERE",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c4-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [780, -120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $json.telegram_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.allowed_chat_id, text: \"Проиндексировано новых транскриптов: \" + $node[\"Execute Workflow\"].json.new_files + \". Всего чанков в базе: \" + $node[\"Execute Workflow\"].json.total_chunks + \".\" }) }}",
        "options": {}
      },
      "id": "c5-notify",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1040, -120]
    },
    {
      "parameters": {},
      "id": "c6-noop",
      "name": "Nothing New",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [780, 120]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Execute Workflow", "type": "main", "index": 0 }]]
    },
    "Execute Workflow": {
      "main": [[{ "node": "New Files > 0", "type": "main", "index": 0 }]]
    },
    "New Files > 0": {
      "main": [
        [{ "node": "Config", "type": "main", "index": 0 }],
        [{ "node": "Nothing New", "type": "main", "index": 0 }]
      ]
    },
    "Config": {
      "main": [[{ "node": "Notify", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
