          "cachedResultName": "Process Transcripts"
        },
        "options": {}
      },
      "id": "a11-execute",
      "name": "Execute Workflow",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [2600, -220],
      "notesInFlow": true,
      "notes": "Выбери воркфлоу 'Process Transcripts' из списка после его импорта."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $node[\"Process Updates & Split\"].json.telegram_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $node[\"Process Updates & Split\"].json.chat_id, text: \"Транскрипт «\" + $node[\"Process Updates & Split\"].json.doc_file_name + \"» добавлен и проиндексирован. В базе \" + $json.total_chunks + \" чанков.\" }) }}",
        "options": {}
      },
      "id": "a12-sendconfirm",
      "name": "Send Confirm",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2860, -220]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "a13-cond",
              "leftValue": "={{ $json.is_text }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equal" }
            }
